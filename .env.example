# rag-hub-mcp — configuration variables
#
# Transport mode (stdio by default; --http flag wins)
RAG_TRANSPORT=stdio

# Required for HTTP mode
# Bearer token for REST endpoints — ignored in stdio mode
MCP_API_KEY=change-me-to-a-secret-key

# Optional (these have defaults)
# EMBEDDINGS_BASE_URL defaults to http://localhost:11434/v1
# KB_ROOT defaults to /data/kbs (http mode) or ./kbs (stdio)
EMBEDDINGS_BASE_URL=http://localhost:11434/v1
KB_ROOT=./kbs
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=bge-m3
# Fixed vector dimension for the embedding column (bge-m3 = 1024). Used by the
# PostgreSQL backend to size the pgvector column.
EMBEDDINGS_DIMENSION=1024
# Maximum characters per chunk before splitting. Lower it when the embedding
# model has a small token limit (e.g. 512 tokens) or for dense scripts such as
# Cyrillic (~2.5 chars/token vs ~4 for English).
CHUNK_MAX_CHARS=3200
# Recommended model: bge-m3 (multilingual FR/EN, 1024d, best open-source retrieval, CPU-friendly)
# Alternatives: nomic-embed-text (lighter, English-focused), text-embedding-3-small (OpenAI)
# Provider: any OpenAI-compatible /v1/embeddings endpoint (Ollama, Bifrost, OpenAI, LM Studio...)
SCAN_INTERVAL=300
# Scan interval in seconds (0 = disabled) — HTTP mode only
PORT=8000
DB_PATH=./rag.db
# Backend storage: sqlite (default, standalone) or postgres (needs a reachable PG)
# STORE_BACKEND=postgres
# Connection: DATABASE_URL takes precedence; fall back to the PG_* vars below.
# DATABASE_URL=postgres://raghub:raghub@localhost:5432/raghub
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=raghub
# PG_USER=raghub
# PG_PASSWORD=raghub
# PG_SSL=false
# Allowed CORS origins (comma-separated). Empty = disables the CORS restriction.
CORS_ORIGINS=
# Additional text file extensions to index (comma-separated, e.g. .kt,.java,.go).
# These are merged with the built-in list (.md,.txt,.js,.ts,.py,.sh,.json,...).
# Files with unknown extensions are also auto-detected as text via magic bytes,
# so this is only needed for edge cases (e.g. files without a text-typical body).
TEXT_EXTENSIONS=
VERSION=1.2.1
# Logging (pino)
# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
# NODE_ENV=development enables pretty output; otherwise JSON on stderr
NODE_ENV=production
# MCP session lifecycle — HTTP mode only
# Idle TTL (seconds): orphaned sessions are closed after this inactivity window
MCP_SESSION_TTL_SECONDS=1800
# Maximum number of concurrent MCP sessions (503 returned when exceeded)
MCP_SESSION_MAX=100
# New-session creation rate (per minute, per IP) — POST /mcp without Mcp-Session-Id
MCP_SESSION_CREATE_RATE_PER_MINUTE=30
# REST rate limits (requests per minute, per IP)
SEARCH_RATE_PER_MINUTE=60
REINDEX_RATE_PER_MINUTE=60
