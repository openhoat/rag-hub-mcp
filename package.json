{
  "name": "rag-hub-mcp",
  "version": "0.0.1",
  "description": "RAG Hub MCP — knowledge bases by folder, exposed via MCP + REST. Uses Ollama/Bifrost/OpenAI-compatible embeddings + SQLite/FTS5.",
  "keywords": [
    "mcp",
    "rag",
    "knowledge-base",
    "embeddings",
    "ai"
  ],
  "license": "MIT",
  "author": "Olivier Penhoat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openhoat/rag-hub-mcp.git"
  },
  "homepage": "https://openhoat.github.io/rag-hub-mcp/",
  "type": "module",
  "bin": {
    "rag-hub-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/coverage/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:docs": "vitepress build docs",
    "coverage": "vitest run --coverage",
    "format": "biome check --formatter-enabled=true --linter-enabled=false src/",
    "lint": "biome check --formatter-enabled=false --linter-enabled=true src/",
    "qa": "biome check src/ && tsc --noEmit && npm run test",
    "qa:fix": "biome check --write src/ && biome check --formatter-enabled=false --linter-enabled=true src/",
    "sonar": "sonar-scanner-npm",
    "start": "node dist/index.js",
    "start:docs": "vitepress dev docs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "npm run qa && npm run build"
  },
  "volta": {
    "node": "24.21.0",
    "npm": "11.19.1"
  },
  "main": "dist/index.js",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "11.10.0",
    "cors": "2.8.6",
    "express": "4.22.2",
    "fast-glob": "3.3.3",
    "jszip": "3.10.2",
    "mammoth": "1.12.2",
    "pdf-parse": "1.1.4",
    "xlsx": "0.18.5",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/better-sqlite3": "7.6.13",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "22.20.2",
    "@types/pdf-parse": "1.1.5",
    "@vitest/coverage-v8": "5.0.0",
    "sonarqube-scanner": "5.0.0",
    "mermaid": "11.16.0",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "5.0.0"
  }
}
