{
  "name": "rag-hub-mcp",
  "version": "1.2.1",
  "description": "RAG Hub MCP — knowledge bases by folder, exposed via MCP + REST. Uses Ollama/Bifrost/OpenAI-compatible embeddings + SQLite/FTS5.",
  "keywords": [
    "mcp",
    "rag",
    "knowledge-base",
    "embeddings",
    "ai"
  ],
  "license": "MIT",
  "author": "Olivier Penhoat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openhoat/rag-hub-mcp.git"
  },
  "homepage": "https://openhoat.github.io/rag-hub-mcp/",
  "type": "module",
  "bin": {
    "rag-hub-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.e2e.test.js",
    "!dist/**/*.e2e.test.d.ts",
    "!dist/coverage/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "wireit",
    "build:docs": "wireit",
    "changelog": "node scripts/changelog.mjs",
    "clean": "rimraf dist",
    "clean:wireit": "rimraf .wireit",
    "qa": "wireit",
    "qa:biome": "wireit",
    "qa:biome:fix": "biome check --write src/",
    "qa:fix": "npm run qa:biome:fix && npm run qa:prettier:fix && npm run qa:markdown:fix",
    "qa:markdown": "wireit",
    "qa:markdown:fix": "markdownlint-cli2 --fix",
    "qa:prettier": "wireit",
    "qa:prettier:fix": "prettier --write \"**/*.md\"",
    "sonar": "wireit",
    "start": "node dist/index.js",
    "start:dev": "NODE_ENV=development tsx src/index.ts",
    "start:docs": "vitepress dev docs",
    "start:inspector": "npx @modelcontextprotocol/inspector npm run start:dev",
    "test": "wireit",
    "test:coverage": "wireit",
    "test:e2e": "wireit",
    "test:unit": "wireit",
    "typecheck": "wireit",
    "validate": "wireit"
  },
  "main": "dist/index.js",
  "volta": {
    "node": "24.21.0",
    "npm": "11.19.1"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "12.11.1",
    "fast-glob": "3.3.3",
    "fastify": "5.12.4",
    "jszip": "3.10.2",
    "mammoth": "1.12.2",
    "pdf-parse": "1.1.4",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "xlsx": "0.18.5",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.2",
    "@types/pdf-parse": "1.1.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.0",
    "conventional-changelog": "8.1.3",
    "conventional-changelog-angular": "9.4.0",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "markdownlint-cli2": "0.23.1",
    "mermaid": "11.16.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "sonarqube-scanner": "5.0.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "5.0.0",
    "wireit": "0.14.13"
  },
  "wireit": {
    "build": {
      "command": "tsc",
      "files": [
        "tsconfig.json",
        "src/**/*.ts"
      ],
      "output": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
      ]
    },
    "build:docs": {
      "command": "vitepress build docs",
      "files": [
        "docs/**/*.md",
        "docs/.vitepress/config.mts",
        "docs/public/**"
      ],
      "output": [
        "dist/docs/**"
      ]
    },
    "clean": {
      "command": "rimraf dist",
      "output": []
    },
    "qa": {
      "dependencies": [
        "qa:biome",
        "qa:markdown",
        "qa:prettier"
      ]
    },
    "qa:biome": {
      "command": "biome check src/",
      "dependencies": [
        "typecheck",
        "test"
      ],
      "files": [
        "biome.json",
        "src/**/*.ts"
      ],
      "output": []
    },
    "qa:markdown": {
      "command": "markdownlint-cli2",
      "files": [
        "**/*.md",
        "!node_modules/**",
        "!dist/**",
        "!coverage/**",
        "!.wireit/**"
      ],
      "output": []
    },
    "qa:prettier": {
      "command": "prettier --check \"**/*.md\"",
      "files": [
        "**/*.md",
        ".prettierignore",
        "!node_modules/**",
        "!dist/**",
        "!coverage/**",
        "!.wireit/**",
        "!.npm/**"
      ],
      "output": []
    },
    "sonar": {
      "command": "sonar-scanner-npm",
      "dependencies": [
        "test:coverage"
      ]
    },
    "test": {
      "command": "vitest run",
      "files": [
        "src/**/*.ts",
        "vitest.config.ts",
        "vitest.setup.ts"
      ],
      "output": []
    },
    "test:coverage": {
      "command": "vitest run --coverage",
      "files": [
        "src/**/*.ts",
        "vitest.config.ts",
        "vitest.setup.ts"
      ],
      "output": [
        "dist/coverage/**"
      ]
    },
    "test:e2e": {
      "command": "vitest run --project e2e",
      "files": [
        "src/**/*.ts",
        "vitest.config.ts",
        "vitest.setup.ts"
      ],
      "output": []
    },
    "test:unit": {
      "command": "vitest run --project unit",
      "files": [
        "src/**/*.ts",
        "vitest.config.ts",
        "vitest.setup.ts"
      ],
      "output": []
    },
    "typecheck": {
      "command": "tsc -p tsconfig.json --noEmit",
      "files": [
        "tsconfig.json",
        "src/**/*.ts"
      ],
      "output": []
    },
    "validate": {
      "dependencies": [
        "build",
        "qa",
        "test:coverage"
      ]
    }
  }
}
