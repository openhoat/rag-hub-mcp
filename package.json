{
  "name": "rag-hub-mcp",
  "version": "0.0.1",
  "description": "RAG Hub MCP — knowledge bases by folder, exposed via MCP + REST. Uses Ollama/Bifrost/OpenAI-compatible embeddings + SQLite/FTS5.",
  "keywords": [
    "mcp",
    "rag",
    "knowledge-base",
    "embeddings",
    "ai"
  ],
  "license": "MIT",
  "author": "Olivier Penhoat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openhoat/rag-hub-mcp.git"
  },
  "homepage": "https://openhoat.github.io/rag-hub-mcp/",
  "type": "module",
  "bin": {
    "rag-hub-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/coverage/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "wireit",
    "build:docs": "wireit",
    "coverage": "wireit",
    "qa": "wireit",
    "qa:fix": "biome check --write src/",
    "sonar": "wireit",
    "start": "node dist/index.js",
    "start:docs": "vitepress dev docs",
    "test": "wireit",
    "typecheck": "wireit",
    "validate": "wireit"
  },
  "main": "dist/index.js",
  "volta": {
    "node": "24.21.0",
    "npm": "11.19.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "11.10.0",
    "cors": "2.8.6",
    "express": "4.22.2",
    "fast-glob": "3.3.3",
    "jszip": "3.10.2",
    "mammoth": "1.12.2",
    "pdf-parse": "1.1.4",
    "xlsx": "0.18.5",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/better-sqlite3": "7.6.13",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "22.20.2",
    "@types/pdf-parse": "1.1.5",
    "@vitest/coverage-v8": "5.0.0",
    "mermaid": "11.16.0",
    "sonarqube-scanner": "5.0.0",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "5.0.0",
    "wireit": "0.14.13"
  },
  "wireit": {
    "build": {
      "command": "tsc",
      "files": ["tsconfig.json", "src/**/*.ts"],
      "output": ["dist/**/*.js", "dist/**/*.d.ts"]
    },
    "build:docs": {
      "command": "vitepress build docs",
      "files": ["docs/**/*.md", "docs/.vitepress/config.mts", "docs/public/**"],
      "output": ["docs/.vitepress/dist/**"]
    },
    "coverage": {
      "command": "vitest run --coverage",
      "files": ["src/**/*.ts", "vitest.config.ts", "vitest.setup.ts"],
      "output": ["dist/coverage/**"]
    },
    "qa": {
      "command": "biome check src/",
      "dependencies": ["typecheck", "test"],
      "files": ["biome.json", "src/**/*.ts"],
      "output": []
    },
    "sonar": {
      "command": "sonar-scanner-npm",
      "dependencies": ["coverage"]
    },
    "test": {
      "command": "vitest run",
      "files": ["src/**/*.ts", "vitest.config.ts", "vitest.setup.ts"],
      "output": []
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "files": ["tsconfig.json", "src/**/*.ts"],
      "output": []
    },
    "validate": {
      "dependencies": ["qa", "build"]
    }
  }
}
